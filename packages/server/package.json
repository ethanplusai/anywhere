{
  "name": "@anywhere/server",
  "version": "0.1.0",
  "private": true,
  "description": "Anywhere server: MCP endpoint, sync API, OAuth and web pages.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/copy-layout.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node scripts/copy-layout.mjs && tsc -p tsconfig.build.json && node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/server": "14.1.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.20",
    "marked": "^18.2.1",
    "nodemailer": "10.6.1",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "layout.md",
    "README.md"
  ]
}
