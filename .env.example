# Copy to .env and edit. docker compose reads it automatically.

# The public address people and agents use, without a trailing slash. The MCP URL is BASE_URL/mcp.
# Choose it once: Claude stores the exact URL, and OAuth metadata is built from it.
BASE_URL=http://localhost:3000

# Port published on the host by docker compose (the container always listens on 3000).
PORT=3000

# Password for the bundled Postgres. Required: docker compose refuses to start without it.
POSTGRES_PASSWORD=change-me

# Email. People sign in with a six-digit code sent by email, so the server needs a way to send it.
# Use Resend (RESEND_API_KEY) or any SMTP server (ANYWHERE_SMTP_URL), not both, and send from a
# subdomain you have set up with SPF, DKIM and DMARC, such as mail.example.com.
# RESEND_API_KEY=
# ANYWHERE_SMTP_URL=smtps://user:pass@smtp.example.com:465
# ANYWHERE_MAIL_FROM=Anywhere <hello@mail.example.com>
# ANYWHERE_MAIL_REPLY_TO=support@example.com
# ANYWHERE_SUPPORT_EMAIL=support@example.com
# On staging or previews: only these addresses (or @domains) receive mail; the rest is dropped.
# ANYWHERE_MAIL_ALLOWLIST=you@example.com,@example.com

# Sign in with GitHub, through your own GitHub OAuth app (github.com/settings/developers). Its
# callback URL is BASE_URL/auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Who may create an account: open, approved (only emails on the early-access list) or closed.
# Set it to closed once your own account exists.
ANYWHERE_SIGNUPS=open
# ANYWHERE_EARLY_ACCESS_URL=https://example.com/early-access
# ANYWHERE_MCP_ORIGIN=https://mcp.example.com

# Requests per minute per user on /api/v1 and /mcp, and per address on sign-in and sign-up.
ANYWHERE_API_RATE_LIMIT=600
ANYWHERE_AUTH_RATE_LIMIT=20
# Sign-in and confirmation codes sent to one address per hour.
# ANYWHERE_SIGNIN_EMAIL_LIMIT=5
# Failed bearer authentications per minute per address; web page requests per minute.
# ANYWHERE_UNAUTH_RATE_LIMIT=30
# ANYWHERE_WEB_RATE_LIMIT=300
# Client registrations per hour server-wide and from one address, and client metadata fetches per
# minute server-wide.
# ANYWHERE_REGISTRATIONS_PER_HOUR=200
# ANYWHERE_REGISTRATIONS_PER_ADDRESS_PER_HOUR=20
# ANYWHERE_CIMD_FETCH_LIMIT=60
# Concurrent /api/v1 and /mcp requests per user in one process.
# ANYWHERE_MAX_CONCURRENT_PER_USER=8

# How rate limits see client addresses. Prefer a header your platform sets and clients cannot forge
# (x-real-ip, cf-connecting-ip, fly-client-ip). Otherwise set ANYWHERE_TRUST_PROXY to the number of
# proxies you control that append to X-Forwarded-For (keep the server's port private then).
# ANYWHERE_CLIENT_IP_HEADER=x-real-ip
ANYWHERE_TRUST_PROXY=0

# Storage quotas per user, checked in every write.
# ANYWHERE_MAX_PROJECTS=50
# ANYWHERE_MAX_PAGES_PER_PROJECT=500
# ANYWHERE_MAX_BYTES_PER_USER=52428800
# ANYWHERE_REVISIONS_KEPT=20
# ANYWHERE_APPEND_COALESCE_SECONDS=600
# ANYWHERE_MAX_SEARCH_QUERY=256
# ANYWHERE_MAX_EXPORT_BYTES=67108864

# Connected apps must be approved again after this many days; web sessions end after this many idle days.
# ANYWHERE_GRANT_LIFETIME_DAYS=90
# ANYWHERE_SESSION_IDLE_DAYS=14
# Extra redirect hosts the consent page names as verified: host=Name,scheme:=Name
# ANYWHERE_VERIFIED_REDIRECTS=

# Without docker compose: point at any Postgres 14+. Leave unset to use the embedded database
# (PGlite) stored in ANYWHERE_PGLITE_DIR, which suits a single person on one machine.
# DATABASE_URL=postgres://user:password@host:5432/anywhere
# ANYWHERE_PGLITE_DIR=./data
# With NODE_ENV=production the server refuses to start without DATABASE_URL unless this is 1.
# ANYWHERE_ALLOW_EMBEDDED_DB=0
# Postgres pool: size, statement timeout, idle-in-transaction timeout.
# ANYWHERE_DB_POOL_MAX=10
# ANYWHERE_DB_STATEMENT_TIMEOUT_MS=15000
# ANYWHERE_DB_IDLE_TX_TIMEOUT_MS=10000
