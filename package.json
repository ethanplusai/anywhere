{
  "name": "anywhere",
  "private": true,
  "version": "0.1.0",
  "description": "Shared project context that every agent you use can read and write.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "local": "pnpm --filter @anywhere/server build && ANYWHERE_LOCAL=1 node packages/server/dist/main.js"
  },
  "homepage": "https://anywr.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanplusai/anywhere.git"
  },
  "bugs": {
    "url": "https://github.com/ethanplusai/anywhere/issues"
  }
}
